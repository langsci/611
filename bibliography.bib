@article{bornkesselGrammarOverridesFrequency2002,
  title = {Grammar Overrides Frequency: Evidence from the Online Processing of Flexible Word Order},
  shorttitle = {Grammar Overrides Frequency},
  author = {Bornkessel, Ina and Schlesewsky, Matthias and Friederici, Angela D.},
  year = {2002},
  month = sep,
  journal = {Cognition},
  volume = {85},
  number = {2},
