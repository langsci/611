}

@article{bardControllingIntelligibilityReferring2000,
  title = {Controlling the {{Intelligibility}} of {{Referring Expressions}} in {{Dialogue}}},
  author = {Bard, Ellen G. and Anderson, Anne H and Sotillo, Catherine and Aylett, Matthew and {Doherty-Sneddon}, Gwyneth and Newlands, Alison},
