@article{gunesAcousticCorrelatesGIVENness2024,
  title = {{Acoustic correlates of GIVENness in Icelandic: Revisiting the Radical Deaccentuation hypothesis}},
  shorttitle = {{Acoustic correlates of GIVENness in Icelandic}},
  author = {G{\"u}ne{\c s}, G{\"u}liz and Deh{\'e}, Nicole},
