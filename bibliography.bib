  shorttitle = {The {{Interplay Between Gesture}} and {{Speech}} in the {{Production}} of {{Referring Expressions}}},
  author = {{de Ruiter}, Jan P. and Bangerter, Adrian and Dings, Paula},
  year = {2012},
  journal = {Topics in Cognitive Science},
