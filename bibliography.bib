@article{kentnerProsodicFocusMarking2016,
  title = {Prosodic {{Focus Marking}} in {{Silent Reading}}: {{Effects}} of {{Discourse Context}} and {{Rhythm}}},
  shorttitle = {Prosodic {{Focus Marking}} in {{Silent Reading}}},
  author = {Kentner, Gerrit and Vasishth, Shravan},
  year = {2016},
