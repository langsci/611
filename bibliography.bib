@inproceedings{shattuck-hufnagelNonreferentialGesturesAdult2016,
  title = {Non-Referential Gestures in Adult and Child Speech: {{Are}} They Prosodic?},
  shorttitle = {Non-Referential Gestures in Adult and Child Speech},
