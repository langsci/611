@article{baron-cohenAnotherAdvancedTest1997,
  title = {Another Advanced Test of {{Theory}} of {{Mind}}: {{Evidence}} from Very High Functioning Adults with Autism or Asperger Syndrome},
  shorttitle = {Another {{Advanced Test}} of {{Theory}} of {{Mind}}},
  author = {Baron-Cohen, Simon and Jolliffe, Therese and Mortimore, Catherine and Robertson, Mary},
  year = {1997},
