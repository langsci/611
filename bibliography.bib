  keywords = {Bayesian stats,focus,GAM,German,prenuclear accents,Production},
  file = {C:\Users\janne\Zotero\storage\DQNEI5TR\Roessig - 2024 - The inverse relation of pre-nuclear and nuclear pr.pdf}
