@techreport{franzProsodicPhrasingSyllable2022,
  type = {Preprint},
  title = {Prosodic {{Phrasing}} and {{Syllable Prominence}} in {{Spoken Prose}}. {{A Validated Coding Manual}}},
  author = {Franz, Isabelle and Knoop, Christine A. and Kentner, Gerrit and Rothbart, Sascha and Kegel, Vanessa and Vasilieva, Julia and Methner, Sanja and Scharinger, Mathias and Menninghaus, Winfried},
