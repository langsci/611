  issn = {00100277},
  doi = {10.1016/S0010-0277(02)00076-8},
  urldate = {2024-04-17},
  abstract = {We show that online processing difficulties induced by word order variations in German cannot be attributed to the relative infrequency of the constructions in question, but rather appear to reflect the application of grammatical principles during parsing. Event-related brain potentials revealed that dative-marked objects in the initial position of an embedded sentence do not elicit a neurophysiologically distinct response from subjects, whereas accusative-marked objects do. These differences are predictable on the basis of grammatical distinctions (i.e. underlying linguistic properties), but not on the basis of frequency information (i.e. a superficial linguistic property). We therefore conclude that the former, but not the latter, guides syntactic integration during online parsing. q 2002 Elsevier Science B.V. All rights reserved.},
