@incollection{baumannReferentialLexicalGivenness2012,
  title = {Referential and Lexical Givenness: {{Semantic}}, Prosodic and Cognitive Aspects},
  shorttitle = {Referential and Lexical Givenness},
  booktitle = {Prosody and {{Meaning}}},
  author = {Baumann, Stefan and Riester, Arndt},
