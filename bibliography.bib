@article{severijnenYourVOORnaamNot2024,
  title = {Your ``{{VOORnaam}}'' Is Not My ``{{VOORnaam}}'': {{An}} Acoustic Analysis of Individual Talker Differences in Word Stress in {{Dutch}}},
  shorttitle = {Your ``{{VOORnaam}}'' Is Not My ``{{VOORnaam}}''},
  author = {Severijnen, Giulio G.A. and Bosker, Hans Rutger and McQueen, James M.},
